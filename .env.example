# =============================================================================
# Elastic Container — Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure for your environment BEFORE first start.
#   cp .env.example .env
#
# NEVER commit .env to version control — it contains passwords and IPs.
# The start script exits if passwords are still 'changeme'.
# =============================================================================

# --- Host addressing (REQUIRED — EDIT THESE) ---------------------------------
#
# SIEM_IP
#   The IP address of this SIEM server on the network where endpoint agents
#   will communicate with Fleet Server and Elasticsearch.
#   - Used for: certificate SANs, Fleet Server host URL, ES output URL
#   - Must be reachable from all endpoint systems
#   - Example: 10.10.20.10
SIEM_IP=<SIEM_ISOLATED_IP>

# SIEM_NAT_IP
#   Optional. A second IP if the SIEM is also reachable through a NAT or
#   management interface. Added to certificate SANs so TLS validates on
#   both addresses. Leave as-is if not applicable.
#   - Used for: certificate SANs only
#   - Example: 192.168.1.50
SIEM_NAT_IP=<SIEM_NAT_IP>

# SIEM_IFACE
#   Name of the network interface on the SIEM host that has SIEM_IP.
#   Used by set-static-ip.sh to configure a static address.
#   - Find yours with: ip link show
#   - Example: ens192, eth0, enp0s3
SIEM_IFACE=<NETWORK_INTERFACE>

# SIEM_PREFIX
#   CIDR prefix length for the SIEM interface (subnet mask in slash notation).
#   - Example: 24 means 255.255.255.0
SIEM_PREFIX=24

# --- Local URLs (一般情况下无需修改) -----------------------------------------
# These point to localhost because the management script runs ON the SIEM host.
LOCAL_KBN_URL=https://127.0.0.1:5601
LOCAL_ES_URL=https://127.0.0.1:9200

# --- Credentials (REQUIRED — CHANGE BEFORE FIRST START) ---------------------
#
# ELASTIC_USERNAME
#   Username used for all admin API calls (Kibana login, Fleet, detection
#   engine). The built-in reserved superuser is 'elastic'. A custom value is
#   created automatically at first boot with the 'superuser' role.
ELASTIC_USERNAME=elastic
#
# ELASTIC_PASSWORD
#   Password for the 'elastic' superuser (or the custom ELASTIC_USERNAME).
#   - Minimum 12 characters (enforced by the start script)
#   - Must NOT be 'changeme', 'password', 'elastic', or any other common default
#   - Used for: Kibana login, API calls, Fleet setup, all admin operations
#   - MUST be set to a strong, unique value
ELASTIC_PASSWORD=changeme

# KIBANA_USERNAME
#   Username Kibana uses to connect to Elasticsearch. The built-in reserved
#   user is 'kibana_system'. A custom value is created automatically at first
#   boot with the 'kibana_system' role.
KIBANA_USERNAME=kibana_system
#
# KIBANA_PASSWORD
#   Password for the 'kibana_system' user (internal Kibana ↔ ES).
#   - Minimum 12 characters (enforced by the start script)
#   - Can be the same as ELASTIC_PASSWORD for lab use
#   - Set once at first boot; not rotatable without re-deploying
KIBANA_PASSWORD=changeme

# --- Elastic Stack Version (一般情况下无需修改) ------------------------------
# Must be a tag that exists for elasticsearch, kibana, and elastic-agent.
# Refresh automatically with: ./elastic-container.sh update-version
STACK_VERSION=9.5.0

# --- Detection Rules (按需启用) -----------------------------------------------
# Bulk-enable prebuilt detection rules by OS at first start (0 or 1).
# Rules are installed regardless; this only enables them.
LinuxDR=0
WindowsDR=1
MacOSDR=0

# The Endpoint Policy also receives the Windows integration (Sysmon/Operational,
# PowerShell/Operational, Windows Defender/Operational, Windows PowerShell).
# Those channels require host-side setup: Sysmon installed+running and
# PowerShell Script Block Logging enabled. See README "Windows telemetry
# prerequisites".

# --- Cluster Settings (一般情况下无需修改) -----------------------------------
CLUSTER_NAME=elastic-container-project
LICENSE=basic

# --- Exposed Ports (一般情况下无需修改) --------------------------------------
# Ports bound on the host. Ensure firewalls allow agent communication.
ES_PORT=9200
KIBANA_PORT=5601
FLEET_PORT=8220

# --- Elasticsearch JVM Heap (按需调整) ---------------------------------------
# Maximum heap size in bytes. Default 2GB. Increase for production.
MEM_LIMIT=2147483648

# --- Kibana Encryption Key (REQUIRED — CHANGE BEFORE FIRST START) -----------
# Used to encrypt saved objects (alert rules, action connectors, etc.).
# Generate a random 32+ character string, e.g.:
#   openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=changeme-generate-a-random-key

# --- Zeek Integration (optional) ---------------------------------------------
# Set ZEEK_ENABLED=1 to create a Zeek Fleet policy and install the Zeek
# integration package. The Elastic Agent on the Zeek host reads JSON logs
# and ships them to Elasticsearch via Fleet.
#
# Prerequisites (operator responsibility — NOT automated by this script):
#   - Zeek installed and running with JSON logging enabled
#   - Elastic Agent installed on the Zeek host and enrolled to the Zeek policy
#   - Network connectivity from Zeek host to Fleet Server (port 8220)
#
# ZEEK_ENABLED=1
# ZEEK_LOG_DIR=/opt/zeek/logs/current
